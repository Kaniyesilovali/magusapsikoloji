{#- SSS sayfası içeriği: _data/faqdata.json → pageCategories[lang].
    Markup eski generate-faq.js üreticisiyle birebir aynı. -#}
{%- set cats = faqdata.pageCategories[lang] %}
    <nav class="flex flex-wrap gap-2 mb-10" aria-label="FAQ categories">
{%- for cat in cats %}
      <a href="#{{ cat.id }}" class="text-xs font-medium px-3.5 py-1.5 rounded-full border border-warm-tertiary bg-warm hover:bg-primary/10 hover:border-primary/30 hover:text-primary transition-colors text-ink-muted">{{ cat.title }}</a>
{%- endfor %}
    </nav>

{#- Schema tarafı head'deki `faqSchemaFromData` JSON-LD bloğundan gelir; aynı
    soruları bir de mikroveri ile işaretlemek sayfada iki FAQPage varlığı
    oluşturuyordu. Görünür metin aynı, işaretleme tek. -#}
    <div>
{%- for cat in cats %}
      <section id="{{ cat.id }}" class="mb-14">
        <h2 class="font-serif text-lg text-ink mb-1 pb-3 border-b-2 border-primary/20">{{ cat.title }}</h2>
        <div>
{%- for item in cat.items %}
        <article class="py-6 border-b border-warm-secondary last:border-0">
          <h3 class="font-semibold text-ink mb-2.5 leading-snug">{{ item.q }}</h3>
          <p class="text-sm text-ink-muted leading-relaxed">{{ item.a }}</p>
        </article>
{%- endfor %}
        </div>
      </section>
{%- endfor %}
    </div>
