<div id="cookieBanner" role="dialog" aria-modal="true" aria-label="Çerez tercihlerinizi yönetin" style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:9999;padding:1rem;background:var(--color-warm);border-top:1px solid var(--color-warm-tertiary);box-shadow:0 -4px 24px color-mix(in srgb, var(--color-ink) 10%, transparent);">
    <div style="max-width:72rem;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;gap:1rem;">
      <div style="flex:1;min-width:220px;">
        <p style="font-size:.85rem;font-weight:600;color:var(--color-ink);margin:0 0 .25rem;">Bu site çerez kullanmaktadır</p>
        <p style="font-size:.78rem;color:var(--color-ink-muted);margin:0;line-height:1.5;">
          Siteyi işletmek için zorunlu çerezler kullanılmaktadır. İleride eklenecek analitik veya pazarlama araçları için ayrıca rızanız alınacaktır.
          <a href="/gizlilik.html" style="color:var(--color-primary);text-decoration:underline;">Gizlilik Politikası</a>
        </p>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;">
        <button id="cookieBtnSettings" style="font-size:.78rem;padding:.45rem .9rem;border-radius:999px;border:1px solid var(--color-ink-light);background:transparent;color:var(--color-ink-muted);cursor:pointer;">
          Tercihler
        </button>
        <button id="cookieBtnReject" style="font-size:.78rem;padding:.45rem .9rem;border-radius:999px;border:1px solid var(--color-ink-light);background:transparent;color:var(--color-ink-muted);cursor:pointer;">
          Sadece Zorunlular
        </button>
        <button id="cookieBtnAccept" style="font-size:.78rem;padding:.45rem .9rem;border-radius:999px;border:none;background:var(--color-primary);color:var(--color-white);cursor:pointer;font-weight:500;">
          Tümünü Kabul Et
        </button>
      </div>
    </div>
  </div>

<div id="cookieModal" role="dialog" aria-modal="true" aria-label="Çerez tercihleri" style="display:none;position:fixed;inset:0;z-index:10000;background:color-mix(in srgb, var(--color-ink) 45%, transparent);padding:1rem;align-items:center;justify-content:center;">
    <div style="background:var(--color-warm);border-radius:1.25rem;max-width:480px;width:100%;padding:2rem;box-shadow:0 8px 40px color-mix(in srgb, var(--color-ink) 18%, transparent);">
      <h2 style="font-size:1rem;font-weight:700;color:var(--color-ink);margin:0 0 .5rem;">Çerez Tercihleriniz</h2>
      <p style="font-size:.78rem;color:var(--color-ink-muted);margin:0 0 1.25rem;line-height:1.55;">
        Aşağıdan hangi çerez kategorilerine izin vermek istediğinizi seçebilirsiniz.
        Zorunlu çerezler her zaman aktiftir.
      </p>

      <!-- Zorunlu -->
      <div style="display:flex;justify-content:space-between;align-items:center;padding:.75rem;background:var(--color-white);border-radius:.75rem;margin-bottom:.5rem;border:1px solid var(--color-warm-tertiary);">
        <div>
          <p style="font-size:.82rem;font-weight:600;color:var(--color-ink);margin:0 0 .15rem;">Zorunlu Çerezler</p>
          <p style="font-size:.72rem;color:var(--color-ink-muted);margin:0;">Sitenin çalışması için gereklidir. Kapatılamaz.</p>
        </div>
        <div style="width:36px;height:20px;border-radius:999px;background:var(--color-primary);flex-shrink:0;position:relative;" title="Her zaman aktif">
          <div style="width:14px;height:14px;border-radius:50%;background:var(--color-white);position:absolute;top:3px;right:3px;"></div>
        </div>
      </div>

      <!-- Analitik -->
      <div style="display:flex;justify-content:space-between;align-items:center;padding:.75rem;background:var(--color-white);border-radius:.75rem;margin-bottom:.5rem;border:1px solid var(--color-warm-tertiary);">
        <div>
          <p style="font-size:.82rem;font-weight:600;color:var(--color-ink);margin:0 0 .15rem;">Analitik Çerezler</p>
          <p style="font-size:.72rem;color:var(--color-ink-muted);margin:0;">Ziyaretçi istatistikleri (ör. Google Analytics).</p>
        </div>
        <button id="toggleAnalytics" role="switch" aria-checked="false" style="width:36px;height:20px;border-radius:999px;background:var(--color-warm-tertiary);flex-shrink:0;position:relative;border:none;cursor:pointer;transition:background .2s;">
          <span style="width:14px;height:14px;border-radius:50%;background:var(--color-white);position:absolute;top:3px;left:3px;transition:left .2s;"></span>
        </button>
      </div>

      <!-- Pazarlama -->
      <div style="display:flex;justify-content:space-between;align-items:center;padding:.75rem;background:var(--color-white);border-radius:.75rem;margin-bottom:1.25rem;border:1px solid var(--color-warm-tertiary);">
        <div>
          <p style="font-size:.82rem;font-weight:600;color:var(--color-ink);margin:0 0 .15rem;">Pazarlama Çerezleri</p>
          <p style="font-size:.72rem;color:var(--color-ink-muted);margin:0;">Kişiselleştirilmiş reklam ve yeniden hedefleme.</p>
        </div>
        <button id="toggleMarketing" role="switch" aria-checked="false" style="width:36px;height:20px;border-radius:999px;background:var(--color-warm-tertiary);flex-shrink:0;position:relative;border:none;cursor:pointer;transition:background .2s;">
          <span style="width:14px;height:14px;border-radius:50%;background:var(--color-white);position:absolute;top:3px;left:3px;transition:left .2s;"></span>
        </button>
      </div>

      <div style="display:flex;gap:.5rem;justify-content:flex-end;">
        <button id="modalBtnCancel" style="font-size:.78rem;padding:.5rem 1rem;border-radius:999px;border:1px solid var(--color-ink-light);background:transparent;color:var(--color-ink-muted);cursor:pointer;">
          İptal
        </button>
        <button id="modalBtnSave" style="font-size:.78rem;padding:.5rem 1rem;border-radius:999px;border:none;background:var(--color-primary);color:var(--color-white);cursor:pointer;font-weight:500;">
          Tercihleri Kaydet
        </button>
      </div>
    </div>
  </div>
