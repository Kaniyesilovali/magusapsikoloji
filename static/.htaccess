# --- Kanonik host: www → non-www (301) ---
# www.magusapsikoloji.com tüm sayfaları magusapsikoloji.com'a kalıcı yönlendir.
# Google'ın www kopyalarını "duplicate/alternate" olarak taramasını önler.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.magusapsikoloji\.com [NC]
RewriteRule ^(.*)$ https://magusapsikoloji.com/$1 [R=301,L]

# --- Dizin sayfaları tek adreste: /yol/index.html → /yol/ (301) ---
# Anasayfa, blog, hizmetler ve EN karşılıkları hem /yol/ hem /yol/index.html
# adresinden 200 dönüyordu. Canonical doğru olsa da Google bunları ayrı URL
# olarak tarayıp "alternatif sayfa" satırına yazıyor; 301 ile tek adres kalır.
# THE_REQUEST kullanılıyor: DirectoryIndex'in dahili yeniden yazımını
# yakalamadığı için sonsuz döngü oluşmaz.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*)index\.html(\?[^\ ]*)?\ HTTP [NC]
RewriteRule ^ /%1 [R=301,L]

# --- Herkese açık onam formu ---
# Metin panelin veritabanında duruyor; sayfayı kökteki onam-formu.php basıyor
# (bkz. static/onam-formu.php). Adres uzantısız ve yönlendirmesiz: bağlantı
# WhatsApp'ta paylaşıldığı gibi açılmalı, araya 301 girmemeli.
# Türkçe metin kökte, İngilizcesi sitenin öteki EN sayfaları gibi /en/ altında.
RewriteRule ^onam-formu/?$ /onam-formu.php [QSA,L]
RewriteRule ^en/consent-form/?$ /onam-formu.php?dil=en [L]

# --- Taşınan eski URL'ler (301) ---
# Meta-refresh yerine gerçek 301; link değerini korur.
Redirect 301 /beyin-beden.html https://magusapsikoloji.com/blog/beyin-beden.html
Redirect 301 /blog/dau-ogrencileri-psikolojik-destek.html https://magusapsikoloji.com/blog/universite-ogrencileri-psikolojik-destek.html

# Çocuk psikoloğu yazısı, hizmet sayfasıyla aynı kelimede yarışmasın diye
# /blog/cocuk-psikologu-magusa.html adresine taşındı (2026-08-28).
Redirect 301 /blog/cocuk-psikologu.html https://magusapsikoloji.com/blog/cocuk-psikologu-magusa.html

# --- Kaldırılan hizmet: Kaygı Terapisi (2026-08-03) ---
# Sayfa yayından kalktı; adresler indekste ve dış bağlantılarda duruyor.
# Hizmet listesine yönlendiriliyor: konu olarak en yakın karşılık orada.
Redirect 301 /hizmetler/kaygi-terapisi.html https://magusapsikoloji.com/hizmetler/
Redirect 301 /en/services/anxiety-therapy.html https://magusapsikoloji.com/en/services/

# --- Kaldırılan hizmet: Çift Terapisi (2026-10-02) ---
# Merkezde çift terapisi verilmiyor; hizmet sayfası ve blog yazısı kaldırıldı.
# Kaygı Terapisi'ndeki gibi hizmet ve blog listelerine yönlendiriliyor.
Redirect 301 /hizmetler/cift-terapisi.html https://magusapsikoloji.com/hizmetler/
Redirect 301 /en/services/couples-therapy.html https://magusapsikoloji.com/en/services/
Redirect 301 /blog/cift-terapisi-gazimagusa.html https://magusapsikoloji.com/blog/
Redirect 301 /en/blog/couples-therapy-famagusta.html https://magusapsikoloji.com/en/blog/

# --- Aile Terapisi → Ebeveyn Danışmanlığı (2026-10-16) ---
# Merkezde aile terapisi verilmiyor; hizmet ebeveyn danışmanlığı olarak yeniden
# yazıldı. Blog yazısı da aynı çerçeveye ("ailede zor dönemler") taşındı.
# Konu karşılığı doğrudan olduğu için listelere değil, yeni sayfalara gidiyor.
Redirect 301 /hizmetler/aile-terapisi.html https://magusapsikoloji.com/hizmetler/ebeveyn-danismanligi.html
Redirect 301 /en/services/family-therapy.html https://magusapsikoloji.com/en/services/parent-counselling.html
Redirect 301 /blog/aile-terapisi-magusa.html https://magusapsikoloji.com/blog/ailede-zor-donemler-ebeveyn-danismanligi.html
Redirect 301 /en/blog/family-therapy-famagusta.html https://magusapsikoloji.com/en/blog/family-transitions-parent-counselling.html

# --- URL yazım hatası düzeltmesi: "magussa" → "magusa" (2026-09-06) ---
# İki blog adresi Gazimağusa'yı çift s ile yazıyordu. Hedeflenen kelimenin
# kendisi yanlış yazıldığı için düzeltildi; eski adresler indekste.
Redirect 301 /blog/aile-terapisi-magussa.html https://magusapsikoloji.com/blog/ailede-zor-donemler-ebeveyn-danismanligi.html
Redirect 301 /blog/cift-terapisi-gazimagussa.html https://magusapsikoloji.com/blog/

# --- "ruh sağlığı" dil rehberi düzeltmesi (2026-09-15) ---
# Dil rehberi "ruh" kelimesini yasaklıyor; kelime bu yazının URL'inde de
# geçiyordu. Yazı /blog/magusa-uluslararasi-ogrenciler-psikolojik-destek.html
# adresine taşındı, eski adres indekste ve iç bağlantılarda duruyordu.
Redirect 301 /blog/magusa-uluslararasi-ogrenciler-ruh-sagligi.html https://magusapsikoloji.com/blog/magusa-uluslararasi-ogrenciler-psikolojik-destek.html

# --- Şehir sayfaları ana sayfaya (2026-10-24) ---
# /gazimagusa-psikolog.html ana sayfayla birebir aynı title'ı taşıyor ve aynı
# kelimeyi hedefliyordu; Google ikisinden birini seçemiyor, gösterimi ana sayfa
# alıyordu. Sayfalar kaldırıldı, değerleri ana sayfalarda toplanıyor.
Redirect 301 /gazimagusa-psikolog.html https://magusapsikoloji.com/
Redirect 301 /en/psychologist-in-famagusta.html https://magusapsikoloji.com/en/
