              <li class="flex items-center gap-2 text-sm text-ink-muted bg-warm px-4 py-2.5 rounded-xl border border-warm-tertiary"><svg class="w-4 h-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4"></path></svg>Anxiety and phobias</li>
              <li class="flex items-center gap-2 text-sm text-ink-muted bg-warm px-4 py-2.5 rounded-xl border border-warm-tertiary"><svg class="w-4 h-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4"></path></svg>Childhood trauma</li>
