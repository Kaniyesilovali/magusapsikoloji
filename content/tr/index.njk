  <script>
    // Eco Systems: auto-orbit all badges (50s/turn) + badge hover highlights
    (function(){
      document.querySelectorAll('.eco-wrap').forEach(function(wrap){
        var badges = wrap.querySelectorAll('.eco-badge');

        // Badge hover → highlight same-system
        badges.forEach(function(badge){
          badge.addEventListener('mouseenter', function(){
            var sys = this.dataset.system;
            badges.forEach(function(b){
              b.classList.toggle('eco-dimmed', b.dataset.system !== sys);
              b.classList.toggle('eco-active',  b.dataset.system === sys);
            });
          });
          badge.addEventListener('mouseleave', function(){
            badges.forEach(function(b){ b.classList.remove('eco-dimmed','eco-active'); });
          });
        });

        // Pre-parse badge data once
        var badgeData = Array.from(badges).map(function(b){
          return { el: b, angle: parseFloat(b.dataset.startAngle), r: parseFloat(b.dataset.radius) };
        });

        // Auto-orbit loop — all badges, 50 sec/full turn
        var deg = 0;
        (function step(){
          deg += 0.04; // 360 / 150s / 60fps ≈ 0.04
          badgeData.forEach(function(d){
            var a = (d.angle + deg) * Math.PI / 180;
            d.el.style.top  = (240 - d.r * Math.cos(a)) + 'px';
            d.el.style.left = (240 + d.r * Math.sin(a)) + 'px';
          });
          requestAnimationFrame(step);
        })();
      });
    })();
  </script>
