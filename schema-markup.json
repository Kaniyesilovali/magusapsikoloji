      "mainEntity": [
        {
          "@type": "Question",
          "name": "Kuzey Kıbrıs'ta psikolog bulmak zor mu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mağusa Psikoloji Merkezi olarak KKTC'de Türkçe ve İngilizce psikoterapi hizmeti sunuyoruz. Yüz yüze seansların yanı sıra online terapi seçeneğiyle Kıbrıs'ın her bölgesinden ulaşabilirsiniz."
          }
        },
        {
          "@type": "Question",
          "name": "Online terapi yüz yüze terapi kadar etkili mi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Araştırmalar, birçok terapi yönteminde online seansların yüz yüze seanslarla benzer etkinlik gösterdiğini ortaya koymaktadır. Özellikle bireysel terapi ve BDT süreçlerinde online format güvenli ve etkili bir alternatiftir."
          }
        },
        {
          "@type": "Question",
          "name": "İngilizce psikoterapi hizmeti veriyor musunuz?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Evet, tüm hizmetlerimiz hem Türkçe hem İngilizce sunulmaktadır. Yabancı uyruklu danışanlar ve uluslararası öğrenciler için İngilizce online ve yüz yüze seans mevcuttur."
          }
        },
        {
          "@type": "Question",
          "name": "Öğrencilere özel terapi hizmeti var mı?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Evet, DAÜ ve diğer üniversitelerdeki öğrencilere yönelik öğrenci danışmanlık hizmetimiz mevcuttur. Sınav kaygısı, uyum sorunları ve akademik stres konularında destek sağlıyoruz."
          }
        }
      ]
